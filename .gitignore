# Personal learning data IS committed so sessions sync across devices
# (phone + PC via Claude Code). Only the automatic backup copies are ignored.
/data/*.json.backup-*

# Personal writing/practice files
myfile.txt

# Backup files created by hooks
.backups/

# System files
.DS_Store
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Python bytecode
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*

# Temp files
.tmp/
temp/
*.json.tmp

